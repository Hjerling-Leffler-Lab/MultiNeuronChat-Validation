# Prefilter comparison (Wasserstein, variance, abundance) for the response to the reviewers (Response Fig. 1).
#
# Not part of the manuscript: MultiNeuronChat runs without a prefilter. This workflow only reads the trimean results of
# the main simulation workflow (results/MNC_results and results/MNC_results_n_sweep), so its `run_all` and `run_n_sweep`
# must have finished first. Run from simulation/:
#
#   snakemake -s workflow/prefilters/Snakefile --profile workflow/profiles/<profile> plot_all

configfile: "workflow/config.yaml"

container: "docker://ghcr.io/siedler/multi-neuron-chat-validation-pipeline:2026.9.5.dev0"

CASES = config["cases"]
PROPORTIONS = config["proportions"]
N_DATASETS = int(config.get("n_datasets", 10))
N_DONORS_SWEEP = config.get("n_donors_sweep", [4, 5, 8, 10, 20])
N_SWEEP_CASES = config.get("n_sweep_cases", ["CASE_0.5", "CASE_1"])
STATISTICAL_TESTS = ['KS', 'CVM', 'MannWhitneyU']
FIGURES = ["all_filters", "without_wasserstein", "wasserstein", "variance", "abundance"]

# The prefilter comparison is done for the default aggregation only.
MEAN_TYPE = "tri_mean"
TRIM_MEAN_FRACTION = config["trim_mean_fractions"]["default"][0]

wildcard_constraints:
    case="CASE_0.3|CASE_0.5|CASE_1|CASE_1.5",
    proportion="0.1|0.3|0.5|0.8|1.0",
    statistical_test="KS|CVM|MannWhitneyU",
    dataset_index="[0-9]+",
    n_donors="[0-9]+",

rule plot_all:
    input:
        # Precision and recall against the proportion of affected donors, one figure per test and log2FC
        # (Response Fig. 1: CVM, all_filters_with_points)
        expand(
            "results/prefilters/figs/precision_recall/{statistical_test}/{mean_type}_{trim_mean_fraction}_{case}/{figure}.pdf",
            statistical_test=STATISTICAL_TESTS,
            mean_type=MEAN_TYPE,
            trim_mean_fraction=TRIM_MEAN_FRACTION,
            case=CASES,
            figure=FIGURES,
        ),
        # Precision and recall against the number of donors per group
        expand(
            "results/prefilters/figs/precision_recall_n_sweep/{statistical_test}/{mean_type}_{trim_mean_fraction}_{case}.pdf",
            statistical_test=STATISTICAL_TESTS,
            mean_type=MEAN_TYPE,
            trim_mean_fraction=TRIM_MEAN_FRACTION,
            case=N_SWEEP_CASES,
        ),
        "results/prefilters/tables/precision_recall_by_prefilter.xlsx",
        "results/prefilters/tables/precision_recall_by_prefilter_vs_no_filter_KS.xlsx",

rule compute_prefilter_statistics:
    input:
        path_to_script="src/prefilters/compute_prefilter_statistics.py",
        path_to_mnc_object=f"results/MNC_results/{MEAN_TYPE}_{TRIM_MEAN_FRACTION}/{{case}}/{{proportion}}/{{case}}_{{proportion}}_{{dataset_index}}.pkl",
    output:
        path_to_prefilter_statistics=f"results/prefilters/statistics/{MEAN_TYPE}_{TRIM_MEAN_FRACTION}/{{case}}/{{proportion}}/{{case}}_{{proportion}}_{{dataset_index}}.pkl",
    threads: 3
    resources:
        slurm_partition="cpu",
        runtime=30,                 # 30 min
        mem_mb=8_000,               # 8 GB
    shell:
        """
        python {input.path_to_script} \
        --path_to_mnc_object {input.path_to_mnc_object} \
        --path_to_prefilter_statistics {output.path_to_prefilter_statistics}
        """

rule summarise_precision_recall_by_prefilter:
    input:
        path_to_script="src/prefilters/summarise_precision_recall_by_prefilter.py",
        paths_to_mnc_object=expand(
            "results/MNC_results/{mean_type}_{trim_mean_fraction}/{{case}}/{{proportion}}/{{case}}_{{proportion}}_{dataset_index}.pkl",
            mean_type=MEAN_TYPE,
            trim_mean_fraction=TRIM_MEAN_FRACTION,
            dataset_index=range(0, N_DATASETS),
        ),
        paths_to_prefilter_statistics=expand(
            "results/prefilters/statistics/{mean_type}_{trim_mean_fraction}/{{case}}/{{proportion}}/{{case}}_{{proportion}}_{dataset_index}.pkl",
            mean_type=MEAN_TYPE,
            trim_mean_fraction=TRIM_MEAN_FRACTION,
            dataset_index=range(0, N_DATASETS),
        ),
        path_to_expected_perturbations="data/simulation/expected_perturbed_pathways_gene_level.csv",
    output:
        path_to_summary_df=f"results/prefilters/summary_dfs/{MEAN_TYPE}_{TRIM_MEAN_FRACTION}_{{statistical_test}}_{{case}}_{{proportion}}.pkl",
    params:
        mean_type=MEAN_TYPE,
        n_per_group=int(config.get("n_samples_per_group_and_sex", 40)) * 2,
    threads: 2
    resources:
        slurm_partition="cpu",
        runtime=60,                 # 1 hour
        mem_mb=4_000,               # 4 GB
    shell:
        """
        python {input.path_to_script} \
        --paths_to_mnc_object {input.paths_to_mnc_object} \
        --paths_to_prefilter_statistics {input.paths_to_prefilter_statistics} \
        --path_to_expected_perturbations {input.path_to_expected_perturbations} \
        --path_to_summary_df {output.path_to_summary_df} \
        --statistical_test {wildcards.statistical_test} \
        --mean_type {params.mean_type} \
        --case {wildcards.case} \
        --proportion {wildcards.proportion} \
        --n_per_group {params.n_per_group}
        """

rule plot_precision_recall_by_prefilter:
    input:
        path_to_script="src/prefilters/plot_precision_recall_by_prefilter.py",
        paths_to_summary_dfs=expand(
            "results/prefilters/summary_dfs/{mean_type}_{trim_mean_fraction}_{{statistical_test}}_{{case}}_{proportion}.pkl",
            mean_type=MEAN_TYPE,
            trim_mean_fraction=TRIM_MEAN_FRACTION,
            proportion=PROPORTIONS,
        ),
    output:
        paths_to_output_figures=[
            f"results/prefilters/figs/precision_recall/{{statistical_test}}/{MEAN_TYPE}_{TRIM_MEAN_FRACTION}_{{case}}/{figure}.pdf"
            for figure in FIGURES
        ],
        # Variants with the individual data points overlaid, written next to each figure by the same script.
        paths_to_output_figures_with_points=[
            f"results/prefilters/figs/precision_recall/{{statistical_test}}/{MEAN_TYPE}_{TRIM_MEAN_FRACTION}_{{case}}/{figure}_with_points.pdf"
            for figure in FIGURES
        ],
    params:
        figure_dir=f"results/prefilters/figs/precision_recall/{{statistical_test}}/{MEAN_TYPE}_{TRIM_MEAN_FRACTION}_{{case}}",
        mean_type=MEAN_TYPE,
        proportions_to_plot=" ".join(map(str, PROPORTIONS)),
        samples_in_dataset=int(config.get("n_samples_per_group_and_sex", 40)) * 2,
        width_of_figure_in_cm=14,
        height_of_figure_in_cm=6.5,
        dpi=300,
        font_size=8,
        label_font_size=8,
    resources:
        slurm_partition="cpu",
        runtime=15,                 # 15 min
        mem_mb=2_000,               # 2 GB
    shell:
        """
        python {input.path_to_script} \
        --paths_to_summary_dfs {input.paths_to_summary_dfs} \
        --path_to_output_figure_all_filters {params.figure_dir}/all_filters.pdf \
        --path_to_output_figure_without_wasserstein {params.figure_dir}/without_wasserstein.pdf \
        --path_to_output_figure_wasserstein {params.figure_dir}/wasserstein.pdf \
        --path_to_output_figure_variance {params.figure_dir}/variance.pdf \
        --path_to_output_figure_abundance {params.figure_dir}/abundance.pdf \
        --mean_type_to_plot {params.mean_type} \
        --case_to_plot {wildcards.case} \
        --proportions_to_plot {params.proportions_to_plot} \
        --samples_in_dataset {params.samples_in_dataset} \
        --statistical_test {wildcards.statistical_test} \
        --width_of_figure_in_cm {params.width_of_figure_in_cm} \
        --height_of_figure_in_cm {params.height_of_figure_in_cm} \
        --dpi {params.dpi} \
        --font_size {params.font_size} \
        --label_font_size {params.label_font_size}
        """

rule summarise_n_sweep_by_prefilter:
    input:
        path_to_script="src/prefilters/summarise_n_sweep_by_prefilter.py",
        paths_to_mnc_object=expand(
            "results/MNC_results_n_sweep/{mean_type}_{trim_mean_fraction}/{{case}}/{{n_donors}}/{{case}}_{{n_donors}}_{dataset_index}.pkl",
            mean_type=MEAN_TYPE,
            trim_mean_fraction=TRIM_MEAN_FRACTION,
            dataset_index=range(0, N_DATASETS),
        ),
        path_to_expected_perturbations="data/simulation/expected_perturbed_pathways_gene_level.csv",
    output:
        path_to_summary_df=f"results/prefilters/summary_dfs_n_sweep/{MEAN_TYPE}_{TRIM_MEAN_FRACTION}_{{case}}_{{n_donors}}.pkl",
    params:
        mean_type=MEAN_TYPE,
    threads: 2
    resources:
        slurm_partition="cpu",
        runtime=30,                 # 30 min
        mem_mb=4_000,               # 4 GB
    shell:
        """
        python {input.path_to_script} \
        --paths_to_mnc_object {input.paths_to_mnc_object} \
        --path_to_expected_perturbations {input.path_to_expected_perturbations} \
        --path_to_summary_df {output.path_to_summary_df} \
        --mean_type {params.mean_type} \
        --case {wildcards.case} \
        --n_donors {wildcards.n_donors}
        """

rule plot_n_sweep_precision_recall_by_prefilter:
    input:
        path_to_script="src/prefilters/plot_n_sweep_precision_recall_by_prefilter.py",
        paths_to_n_sweep_summary_dfs=expand(
            "results/prefilters/summary_dfs_n_sweep/{mean_type}_{trim_mean_fraction}_{{case}}_{n_donors}.pkl",
            mean_type=MEAN_TYPE,
            trim_mean_fraction=TRIM_MEAN_FRACTION,
            n_donors=N_DONORS_SWEEP,
        ),
        # The full-cohort benchmark at proportion 1.0 is drawn as the largest cohort of the sweep.
        paths_to_full_cohort_summary_dfs=expand(
            "results/prefilters/summary_dfs/{mean_type}_{trim_mean_fraction}_{statistical_test}_{{case}}_1.0.pkl",
            mean_type=MEAN_TYPE,
            trim_mean_fraction=TRIM_MEAN_FRACTION,
            statistical_test=STATISTICAL_TESTS,
        ),
    output:
        paths_to_output_figure_filters=[
            f"results/prefilters/figs/precision_recall_n_sweep/{statistical_test}/{MEAN_TYPE}_{TRIM_MEAN_FRACTION}_{{case}}.pdf"
            for statistical_test in STATISTICAL_TESTS
        ],
        # Variants with the individual data points overlaid, written next to each figure by the same script.
        paths_to_output_figure_filters_with_points=[
            f"results/prefilters/figs/precision_recall_n_sweep/{statistical_test}/{MEAN_TYPE}_{TRIM_MEAN_FRACTION}_{{case}}_with_points.pdf"
            for statistical_test in STATISTICAL_TESTS
        ],
    params:
        mean_type=MEAN_TYPE,
        n_donors=" ".join(map(str, N_DONORS_SWEEP)),
        full_cohort_n_per_group=int(config.get("n_samples_per_group_and_sex", 40)) * 2,
    resources:
        slurm_partition="cpu",
        runtime=10,                 # 10 min
        mem_mb=800,                 # 800 MB
    shell:
        """
        python {input.path_to_script} \
        --paths_to_n_sweep_summary_dfs {input.paths_to_n_sweep_summary_dfs} \
        --paths_to_full_cohort_summary_dfs {input.paths_to_full_cohort_summary_dfs} \
        --mean_type {params.mean_type} \
        --case {wildcards.case} \
        --n_donors {params.n_donors} \
        --full_cohort_n_per_group {params.full_cohort_n_per_group} \
        --paths_to_output_figure_filters {output.paths_to_output_figure_filters}
        """

rule create_precision_recall_by_prefilter_tables:
    input:
        path_to_pr_summary_tables_script="src/prefilters/create_pr_summary_tables.py",
        path_to_pr_comparison_summary_table_script="src/prefilters/create_pr_comparison_summary_table.py",
        paths_to_summary_dfs=expand(
            "results/prefilters/summary_dfs/{mean_type}_{trim_mean_fraction}_{statistical_test}_{case}_{proportion}.pkl",
            mean_type=MEAN_TYPE,
            trim_mean_fraction=TRIM_MEAN_FRACTION,
            statistical_test=STATISTICAL_TESTS,
            case=CASES,
            proportion=PROPORTIONS,
        ),
    output:
        # Precision and recall per dataset, test and prefilter
        path_to_pr_summary_table_excel="results/prefilters/tables/precision_recall_by_prefilter.xlsx",
        # KS: mean precision and recall per prefilter and the difference to no filter
        path_to_pr_comparison_summary_table_excel="results/prefilters/tables/precision_recall_by_prefilter_vs_no_filter_KS.xlsx",
    params:
        path_to_summary_files="results/prefilters/summary_dfs/",
    resources:
        slurm_partition="cpu",
        runtime=10,                 # 10 min
        mem_mb=800,                 # 800 MB
    shell:
        """
        python {input.path_to_pr_summary_tables_script} \
        --path_to_summary_files {params.path_to_summary_files} \
        --path_to_pr_summary_table_excel {output.path_to_pr_summary_table_excel}

        python {input.path_to_pr_comparison_summary_table_script} \
        --path_to_summary_files {params.path_to_summary_files} \
        --path_to_pr_summary_table_excel {output.path_to_pr_comparison_summary_table_excel}
        """
