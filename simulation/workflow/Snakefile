            'results/figs/pr_curves_n_sweep/summary_data/pr_aucs/{mean_type}_{trim_mean_fraction}_{case}_{n_donors}.pkl',
            mean_type=N_SWEEP_MEAN_TYPES,
            trim_mean_fraction=config['trim_mean_fractions']['default'],
            case=lambda wildcards: wildcards.case,
            n_donors=N_DONORS_SWEEP,
        ),
        path_to_error_bands_dict=expand(
            'results/figs/pr_curves_n_sweep/summary_data/error_bands/{mean_type}_{trim_mean_fraction}_{case}_{n_donors}.pkl',
            mean_type=N_SWEEP_MEAN_TYPES,
            trim_mean_fraction=config['trim_mean_fractions']['default'],
            case=lambda wildcards: wildcards.case,
            n_donors=N_DONORS_SWEEP,
        ),
    output:
        path_to_output_figure='results/figs/pr_auc_vs_n_donors/{case}.pdf',
    params:
        path_to_curves='results/figs/pr_curves_n_sweep/summary_data/curves/',
        path_to_pr_aucs='results/figs/pr_curves_n_sweep/summary_data/pr_aucs/',
        path_to_error_bands_dict='results/figs/pr_curves_n_sweep/summary_data/error_bands/',

        mean_types=" ".join([f"{m}_0" for m in N_SWEEP_MEAN_TYPES]),
        n_donors=" ".join(map(str, N_DONORS_SWEEP)),

        width_in_cm=14,
        height_in_cm=8,
        font_size=8,
    wildcard_constraints:
        case="CASE_0.3|CASE_0.5|CASE_1|CASE_1.5",
    resources:
        slurm_partition="cpu",
        runtime=5,  # 5 min
        mem_mb=800,  # 800 MB
    shell:
        """
        python {input.path_to_script} \
        --path_to_curves {params.path_to_curves} \
        --path_to_pr_aucs {params.path_to_pr_aucs} \
        --path_to_error_bands_dict {params.path_to_error_bands_dict} \
        --path_to_output_figure {output.path_to_output_figure} \
        --case {wildcards.case} \
        --mean_types {params.mean_types} \
        --n_donors {params.n_donors} \
        --width_in_cm {params.width_in_cm} \
        --height_in_cm {params.height_in_cm} \
        --font_size {params.font_size}
        """

rule create_pr_auc_vs_n_donors_table:
    input:
        path_to_script='src/tables/create_pr_auc_vs_n_donors_table.py',

        path_to_pr_aucs_outputs=expand(
            'results/figs/pr_curves_n_sweep/summary_data/pr_aucs/{mean_type}_{trim_mean_fraction}_{case}_{n_donors}.pkl',
            mean_type=N_SWEEP_MEAN_TYPES,
            trim_mean_fraction=config['trim_mean_fractions']['default'],
            case=N_SWEEP_CASES,
            n_donors=N_DONORS_SWEEP,
        ),
    output:
        path_to_pr_auc_summary_table_excel="results/tables/T5_pr_auc_vs_n_donors.xlsx",
    params:
        path_to_summary_pkls="results/figs/pr_curves_n_sweep/summary_data/pr_aucs/",
        mean_types=" ".join([f"{m}_0" for m in N_SWEEP_MEAN_TYPES]),
        cases=" ".join(N_SWEEP_CASES),
        n_donors=" ".join(map(str, N_DONORS_SWEEP)),
    resources:
        slurm_partition = "cpu",
        runtime = 10,               # 10 min
        mem_mb = 800,             # 800 MB
    shell:
        """
        python {input.path_to_script} \
        --path_to_summary_pkls {params.path_to_summary_pkls} \
        --path_to_pr_auc_summary_table_excel {output.path_to_pr_auc_summary_table_excel} \
        --mean_types {params.mean_types} \
        --cases {params.cases} \
        --n_donors {params.n_donors}
        """

