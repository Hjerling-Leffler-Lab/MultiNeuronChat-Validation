        path_to_curves_output='results/figs/pr_curves/summary_data/curves/{mean_type}_{trim_mean_fraction}_{case}_{proportion}.pkl',
        path_to_pr_aucs_output='results/figs/pr_curves/summary_data/pr_aucs/{mean_type}_{trim_mean_fraction}_{case}_{proportion}.pkl',
        path_to_error_bands_dict='results/figs/pr_curves/summary_data/error_bands/{mean_type}_{trim_mean_fraction}_{case}_{proportion}.pkl',
    params:
        statistical_tests="KS CVM MannWhitneyU",
    wildcard_constraints:
        mean_type="mean|tri_mean|trim_mean",
        trim_mean_fraction="0|0\\.[0-9]+",
        case="CASE_0.3|CASE_0.5|CASE_1|CASE_1.5",
        proportion="0.1|0.3|0.5|0.8|1.0",
        dataset_index="[0-9]+",
    resources:
        slurm_partition = "cpu",
        runtime = 240,  # 4 hours
        mem_mb = 2_000,  # 2 GB
    shell:
        """
        python {input.path_to_script} \
        --paths_to_mnc_files {input.path_to_mnc_files} \
        --path_to_expected_perturbations {input.path_to_expected_perturbations} \
