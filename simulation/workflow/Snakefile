configfile: "workflow/config.yaml"

container: "docker://ghcr.io/siedler/multi-neuron-chat-validation-pipeline:2026.8.18.dev0"

CASES = config["cases"]
MEAN_TYPES = config["mean_types"]
PROPORTIONS = config["proportions"]
SEXES = config.get("sexes", ["f", "m"])
N_DATASETS = int(config.get("n_datasets", 10))

# Population-size (donor-count) benchmark — see config.yaml.
N_DONORS_SWEEP = config.get("n_donors_sweep", [2, 3, 5, 8, 10, 20])
N_SWEEP_CASES = config.get("n_sweep_cases", ["CASE_0.5", "CASE_1"])
N_SWEEP_PROPORTION = config.get("n_sweep_proportion", 1.0)
N_SWEEP_MEAN_TYPES = config.get("n_sweep_mean_types", ["mean", "tri_mean"])

rule run_all:
    input:
        expand(
            'results/neuron_chat/timing/{case}_{proportion}_{dataset_index}_comparison.csv',
            case=CASES,
            proportion=PROPORTIONS,
            dataset_index=range(0,N_DATASETS),
        ),
        expand(
            f"results/MNC_results/{{mean_type}}_{{trim_mean_fraction}}/{{case}}/{{proportion}}/{{case}}_{{proportion}}_{{dataset_index}}.pkl",
            mean_type=["mean", "tri_mean"],
            trim_mean_fraction=config["trim_mean_fractions"]["default"],
            case=CASES,
            proportion=PROPORTIONS,
            dataset_index=range(0, N_DATASETS),
        ),
        expand(
            f"results/MNC_results/{{mean_type}}_{{trim_mean_fraction}}/{{case}}/{{proportion}}/{{case}}_{{proportion}}_{{dataset_index}}.pkl",
           mean_type=["trim_mean"],
            trim_mean_fraction=config["trim_mean_fractions"]["trim_mean"],
            case=CASES,
            proportion=PROPORTIONS,
            dataset_index=range(0, N_DATASETS),
        ),

