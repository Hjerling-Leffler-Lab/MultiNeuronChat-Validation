rule plot_precision_recall_plots:
    input:
        path_to_script="src/plotting/plot_precision_recall_b.py",

        paths_to_summary_dfs = expand(
            "results/figs/precision_recall/summary_dfs/{mean_type}_{trim_mean_fraction}_{statistical_test}_{case}_{proportion}.pkl",
            mean_type=lambda wildcards: wildcards.mean_type,
            trim_mean_fraction=lambda wildcards: wildcards.trim_mean_fraction,
            statistical_test=lambda wildcards: wildcards.statistical_test,
            case=lambda wildcards: wildcards.case,
            proportion=PROPORTIONS,
        ),
    output:
        path_to_output_figure="results/figs/precision_recall/{statistical_test}/{mean_type}_{trim_mean_fraction}_{case}.pdf"
    params:
        mean_type_to_plot=lambda wildcards: wildcards.mean_type,
        case_to_plot=lambda wildcards: wildcards.case,
        proportions_to_plot=" ".join(map(str, PROPORTIONS)),
        samples_in_dataset=int(config.get("n_samples_per_group_and_sex", 40))*2,
        statistical_tests=lambda wildcards: wildcards.statistical_test,
        width_of_figure_in_cm=8.5,
        height_of_figure_in_cm=8.2/2,
        dpi=300,
        font_size=8,
        label_font_size=8,
        show_figure=False
    wildcard_constraints:
        mean_type = "mean|tri_mean|trim_mean",
        trim_mean_fraction = "0|0\\.[0-9]+",
        case = "CASE_0.3|CASE_0.5|CASE_1|CASE_1.5",
        statistical_test="KS|CVM|MannWhitneyU",
    resources:
        slurm_partition="cpu",
        runtime=60,                 # 1 hours
        mem_mb=4_000,               # 4 GB
    shell:
        """
        python {input.path_to_script} \
        --paths_to_summary_dfs {input.paths_to_summary_dfs} \
        --path_to_output_figure {output.path_to_output_figure} \
        --mean_type_to_plot {params.mean_type_to_plot} \
        --case_to_plot {params.case_to_plot} \
        --proportions_to_plot {params.proportions_to_plot} \
        --samples_in_dataset {params.samples_in_dataset} \
        --statistical_tests {params.statistical_tests} \
        --width_of_figure_in_cm {params.width_of_figure_in_cm} \
        --height_of_figure_in_cm {params.height_of_figure_in_cm} \
        --dpi {params.dpi} \
        --font_size {params.font_size} \
        --label_font_size {params.label_font_size}
        """

rule create_summary_statistics:
    input:
        path_to_script="src/plotting/plot_precision_recall_a.py",

        paths_to_mnc_object=expand(
            "results/MNC_results/{mean_type}_{trim_mean_fraction}/{case}/{proportion}/{case}_{proportion}_{dataset_index}.pkl",
            statistical_test=lambda wildcards: wildcards.statistical_test,
            mean_type=lambda wildcards: wildcards.mean_type,
            trim_mean_fraction=lambda wildcards: wildcards.trim_mean_fraction,
            case=lambda wildcards: wildcards.case,
            proportion=lambda wildcards: wildcards.proportion,
            dataset_index=range(0,N_DATASETS),
        ),
        paths_to_wasserstein_object=expand(
            "results/Wasserstein_results/{mean_type}_{trim_mean_fraction}/{case}/{proportion}/{case}_{proportion}_{dataset_index}.pkl",
            statistical_test=lambda wildcards: wildcards.statistical_test,
            mean_type=lambda wildcards: wildcards.mean_type,
            trim_mean_fraction=lambda wildcards: wildcards.trim_mean_fraction,
            case=lambda wildcards: wildcards.case,
            proportion=lambda wildcards: wildcards.proportion,
            dataset_index=range(0,N_DATASETS),
        ),
        path_to_expected_perturbations="data/simulation/expected_perturbed_pathways.csv"
    output:
        path_to_summary_df="results/figs/precision_recall/summary_dfs/{mean_type}_{trim_mean_fraction}_{statistical_test}_{case}_{proportion}.pkl",
    params:
        statistical_test=lambda wildcards: wildcards.statistical_test,
        mean_type=lambda wildcards: wildcards.mean_type,
        trim_mean_fraction= lambda wildcards: wildcards.trim_mean_fraction,
        case=lambda wildcards: wildcards.case,
        proportion=lambda wildcards: wildcards.proportion,
    wildcard_constraints:
        mean_type="mean|tri_mean|trim_mean",
        trim_mean_fraction="0|0\\.[0-9]+",
        case="CASE_0.3|CASE_0.5|CASE_1|CASE_1.5",
        proportion="0.1|0.3|0.5|0.8|1.0",
        dataset_index="[0-9]+",
    resources:
        slurm_partition="cpu",
        runtime=240,                # 4 hours
        mem_mb=2_000,               # 2 GB
    shell:
        """
        python {input.path_to_script} \
        --paths_to_mnc_object {input.paths_to_mnc_object} \
        --paths_to_wasserstein_object {input.paths_to_wasserstein_object} \
        --path_to_expected_perturbations {input.path_to_expected_perturbations} \
        --path_to_summary_df {output.path_to_summary_df} \
        --statistical_test {params.statistical_test} \
        --mean_type {params.mean_type} \
        --case {params.case} \
        --proportion {params.proportion}
        """

rule get_pr_curve_data:
    input:
        path_to_script = "src/plotting/plot_pr_curves_a.py",

        path_to_mnc_files = expand(
            "results/MNC_results/{mean_type}_{trim_mean_fraction}/{case}/{proportion}/{case}_{proportion}_{dataset_index}.pkl",
            mean_type=lambda wildcards: wildcards.mean_type,
            trim_mean_fraction=lambda wildcards: wildcards.trim_mean_fraction,
            case=lambda wildcards: wildcards.case,
            proportion=lambda wildcards: wildcards.proportion,
            dataset_index=range(0,N_DATASETS),
        ),
        path_to_expected_perturbations="data/simulation/expected_perturbed_pathways.csv"
