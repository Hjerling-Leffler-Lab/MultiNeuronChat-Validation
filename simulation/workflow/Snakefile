# Parallel branch of combine -> normalize -> MNC -> PR-AUC that sweeps the number of donors
# instead of the proportion of affected donors. It reuses the same simulated patient pool
# (no SPARSim re-run): cohort size is the `--n_samples_per_group_and_sex` argument of script 5,
# which sub-samples without replacement. proportion is pinned to N_SWEEP_PROPORTION.

rule combine_SPARSim_datasets_n_sweep:
    input:
        case_looms = lambda wildcards: expand(
            f"data/simulated_patients/updated_version/{{case}}/{{sex}}/{{case}}_{{i}}.loom",
            case=[wildcards.case],
            sex=SEXES,
            i=range(1, int(config.get("n_people_to_simulate", 60)) + 1),
        ),
        unperturbed_case_looms = expand(
            f"data/simulated_patients/updated_version/CASE_0/{{sex}}/CASE_0_{{i}}.loom",
            sex=SEXES,
            i=range(1, int(config.get("n_people_to_simulate", 60)) + 1),
        ),
        control_looms = expand(
            f"data/simulated_patients/updated_version/CTRL_0/{{sex}}/CTRL_0_{{i}}.loom",
            sex=SEXES,
            i=range(1, int(config.get("n_people_to_simulate", 60)) + 1),
        ),

        path_to_script="src/5_combine_SPARSim_dataset.py",

    output:
        path_to_output_loom=f"data/simulated_datasets_n_sweep/{{case}}/{{n_donors}}/{{case}}_{{n_donors}}_{{dataset_index}}.loom",
        path_to_patient_meta_output_file=f"data/simulated_meta_n_sweep/{{case}}/{{n_donors}}/{{case}}_{{n_donors}}_{{dataset_index}}_meta.csv",
    params:
        path_to_case=lambda wildcards: f"data/simulated_patients/updated_version/{wildcards.case}",
        path_to_non_perturbed_case_folder = f"data/simulated_patients/updated_version/CASE_0/",
        path_to_ctrl_folder = f"data/simulated_patients/updated_version/CTRL_0/",

        proportion_of_affected_donors=N_SWEEP_PROPORTION,
        dataset_index=lambda wildcards: wildcards.dataset_index,
        n_samples_per_group_and_sex=lambda wildcards: wildcards.n_donors,
    wildcard_constraints:
        case="CASE_0.3|CASE_0.5|CASE_1|CASE_1.5",
        n_donors="[0-9]+",
        dataset_index="[0-9]+",
    resources:
        slurm_partition = "cpu",
        runtime = 120,              # 2 hours (small cohorts)
        mem_mb = 12_000,            # 12 GB
    shell:
        """
