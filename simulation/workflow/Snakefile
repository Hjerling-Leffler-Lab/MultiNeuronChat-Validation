rule combine_SPARSim_datasets:
    input:
        case_looms = lambda wildcards: expand(
            f"data/simulated_patients/updated_version/{{case}}/{{sex}}/{{case}}_{{i}}.loom",
            case=[wildcards.case],
            sex=SEXES,
            i=range(1, int(config.get("n_people_to_simulate", 60)) + 1),
        ),
        unperturbed_case_looms = expand(
            f"data/simulated_patients/updated_version/CASE_0/{{sex}}/CASE_0_{{i}}.loom",
            sex=SEXES,
            i=range(1, int(config.get("n_people_to_simulate", 60)) + 1),
        ),
        control_looms = expand(
            f"data/simulated_patients/updated_version/CTRL_0/{{sex}}/CTRL_0_{{i}}.loom",
            sex=SEXES,
            i=range(1, int(config.get("n_people_to_simulate", 60)) + 1),
        ),

        path_to_script="src/5_combine_SPARSim_dataset.py",

    output:
        path_to_output_loom=f"data/simulated_datasets/{{case}}/{{proportion}}/{{case}}_{{proportion}}_{{dataset_index}}.loom",
        path_to_patient_meta_output_file=f"data/simulated_meta/{{case}}/{{proportion}}/{{case}}_{{proportion}}_{{dataset_index}}_meta.csv",
    params:
        path_to_case=lambda wildcards: f"data/simulated_patients/updated_version/{wildcards.case}",
        path_to_non_perturbed_case_folder = f"data/simulated_patients/updated_version/CASE_0/",
        path_to_ctrl_folder = f"data/simulated_patients/updated_version/CTRL_0/",

        proportion_of_affected_donors=lambda wildcards: wildcards.proportion,
        dataset_index=lambda wildcards: wildcards.dataset_index,
        n_samples_per_group_and_sex=int(config.get("n_samples_per_group_and_sex", 40)),
    wildcard_constraints:
        case="CASE_0.3|CASE_0.5|CASE_1|CASE_1.5",
        proportion="0.1|0.3|0.5|0.8|1.0",
        dataset_index="[0-9]+",
    resources:
        slurm_partition = "cpu",
        runtime = 480,              # 8 hour
        mem_mb = 12_000,            # 12 GB
    shell:
        """
        python {input.path_to_script} \
        --path_to_case {params.path_to_case} \
        --path_to_non_perturbed_case_folder {params.path_to_non_perturbed_case_folder} \
        --path_to_ctrl_folder {params.path_to_ctrl_folder} \
        --path_to_output_loom {output.path_to_output_loom} \
        --path_to_patient_meta_output_file {output.path_to_patient_meta_output_file} \
        --proportion_of_affected_donors {params.proportion_of_affected_donors} \
        --dataset_index {params.dataset_index} \
