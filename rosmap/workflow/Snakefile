rule plot_p_value_circle_plots:
    input:
        path_to_script="src/b_plot_mnc_coarse_p_value_circle_plot.py",

        path_to_mnc_object=lambda wildcards: mnc_object_per_resolution[wildcards.resolution]
    output:
        path_to_p_value_circle_plot_png="results/figs/{resolution}/{test}/padj_{threshold}/png/p_value_circle_plot.png",
        path_to_p_value_legend_png="results/figs/{resolution}/{test}/padj_{threshold}/png/p_value_legend.png",
        path_to_p_value_arrow_legend_png="results/figs/{resolution}/{test}/padj_{threshold}/png/p_value_arrow_legend.png",
        path_to_p_value_circle_plot_pdf="results/figs/{resolution}/{test}/padj_{threshold}/pdf/p_value_circle_plot.pdf",
        path_to_p_value_legend_pdf="results/figs/{resolution}/{test}/padj_{threshold}/pdf/p_value_legend.pdf",
        path_to_p_value_arrow_legend_pdf="results/figs/{resolution}/{test}/padj_{threshold}/pdf/p_value_arrow_legend.pdf",
    wildcard_constraints:
        resolution="|".join(resolutions),
        threshold=r"[0-9.]+",
    params:
        statistical_test="{test}",
        significance_threshold="{threshold}",

        width_in_cm_main=lambda wildcards: circle_plot_size_per_resolution[wildcards.resolution],
        height_in_cm_main=lambda wildcards: circle_plot_size_per_resolution[wildcards.resolution],

        width_in_cm_legend_cell_type=7,
        height_in_cm_legend_cell_type=lambda wildcards: circle_plot_legend_height_per_resolution[wildcards.resolution],

        width_in_cm_legend_arrow=3,
        height_in_cm_legend_arrow=1.5,
    resources:
        slurm_partition="cpu",
        runtime=5,# 5 minutes
        mem_mb=4_000,# 4 GB
    shell:
        """
        python {input.path_to_script} \
            --path_to_mnc_object {input.path_to_mnc_object} \
            --path_to_p_value_circle_plot_png {output.path_to_p_value_circle_plot_png} \
            --path_to_p_value_legend_png {output.path_to_p_value_legend_png} \
            --path_to_p_value_arrow_legend_png {output.path_to_p_value_arrow_legend_png} \
            --path_to_p_value_circle_plot_pdf {output.path_to_p_value_circle_plot_pdf} \
            --path_to_p_value_legend_pdf {output.path_to_p_value_legend_pdf} \
            --path_to_p_value_arrow_legend_pdf {output.path_to_p_value_arrow_legend_pdf} \
            --statistical_test {params.statistical_test} \
            --significance_threshold {params.significance_threshold} \
            --width_in_cm_main {params.width_in_cm_main} \
            --height_in_cm_main {params.height_in_cm_main} \
            --width_in_cm_legend_cell_type {params.width_in_cm_legend_cell_type} \
            --height_in_cm_legend_cell_type {params.height_in_cm_legend_cell_type} \
            --width_in_cm_legend_arrow {params.width_in_cm_legend_arrow} \
            --height_in_cm_legend_arrow {params.height_in_cm_legend_arrow}
        """

