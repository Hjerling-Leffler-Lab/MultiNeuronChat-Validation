container: "docker://ghcr.io/siedler/multi-neuron-chat-validation-pipeline:2026.9.5.dev0"

statistical_tests = ["CVM"]

# BH-adjusted p-value thresholds per test for the plots, independent of the MNC run above;
# each threshold gets its own figure set under results/figs/{resolution}/{test}/padj_{threshold}/
plot_thresholds = {"CVM": [0.1, 0.05]}
plot_test_dirs = [f"{test}/padj_{threshold}" for test, thresholds in plot_thresholds.items() for threshold in thresholds]

# Both annotations come out of the same MNC run (run_rosmap_coarse); coarse = grouping.by, fine = cell.type
resolutions = ["coarse"]
mnc_object_per_resolution = {
    "coarse": "results/coarse/mnc_grouping_by.pkl",
    "fine": "results/coarse/mnc_cell_type.pkl",
}
cell_type_label_column_per_resolution = {"coarse": "grouping.by", "fine": "cell.type"}

# Figure sizes (cm) that differ between the 7 coarse and ~23 fine cell types
circle_plot_size_per_resolution = {"coarse": 7, "fine": 12}
circle_plot_legend_height_per_resolution = {"coarse": 3, "fine": 8}
heatmap_size_per_resolution = {"coarse": (8, 7), "fine": (18, 16)}

# Tetrad selections for the donor x tetrad communication-score clustermaps
clustermap_selections = ["significant", "top_10", "top_20"]

rule run_all:
    input:
        # Generate MNC results for the coarse and fine annotation
        "results/coarse/mnc_cell_type.pkl",
        "results/coarse/mnc_grouping_by.pkl",

        # Add final plots for the coarse and fine analysis
        expand("results/figs/{resolution}/{test_dir}/{ext}/p_value_circle_plot.{ext}",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/{resolution}/{test_dir}/{ext}/p_value_legend.{ext}",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/{resolution}/{test_dir}/{ext}/p_value_arrow_legend.{ext}",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),

rule plot_all:
    input:
        "results/figs/clinical_data_plot.pdf",

        expand("results/figs/{resolution}/{test_dir}/{ext}/p_value_circle_plot.{ext}",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/{resolution}/{test_dir}/{ext}/p_value_legend.{ext}",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/{resolution}/{test_dir}/{ext}/p_value_arrow_legend.{ext}",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),

        expand("results/figs/{resolution}/{test_dir}/{ext}/significant_boxplots.{ext}",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/{resolution}/{test_dir}/{ext}/ligand_target_decomposition.{ext}",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/{resolution}/{test_dir}/{ext}/single_panels/ligand_target_decomposition",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/{resolution}/{test_dir}/{ext}/significant_ecdfs.{ext}",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/{resolution}/{test_dir}/{ext}/significance_heatmap.{ext}",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/{resolution}/{test_dir}/{ext}/significant_vs_severity.{ext}",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/{resolution}/{test_dir}/{ext}/significant_vs_confounders.{ext}",resolution=resolutions,test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/{resolution}/{test_dir}/{ext}/score_clustermap_{selection}.{ext}",resolution=resolutions,test_dir=plot_test_dirs,selection=clustermap_selections,ext=["png", "pdf"]),


rule join_rosmap_data:
    input:
        path_to_script="src/1_join_rosmap_data.py",

        path_to_cell_annotations="data/raw/cell-annotation.n437.csv",
        path_to_clinical_data="data/raw/ROSMAP_clinical.csv",
        path_to_matrices="data/raw/count_matrices",
    output:
        path_to_output_loom="data/raw/joined_matrix.loom",
    resources:
        slurm_partition="cpu",
        runtime=600,# 10 hours
        mem_mb=45_000,# 45 GB
    shell:
        """
        python {input.path_to_script} \
            --path_to_cell_annotations {input.path_to_cell_annotations} \
            --path_to_clinical_data {input.path_to_clinical_data} \
            --path_to_matrices {input.path_to_matrices} \
            --path_to_output_loom {output.path_to_output_loom}
        """

