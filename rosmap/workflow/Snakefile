        path_to_script="src/b_plot_mnc_coarse_p_value_circle_plot.py",

        path_to_mnc_object=mnc_object,
    output:
        path_to_p_value_circle_plot_png=f"{fig_dir}/png/p_value_circle_plot.png",
        path_to_p_value_legend_png=f"{fig_dir}/png/p_value_legend.png",
