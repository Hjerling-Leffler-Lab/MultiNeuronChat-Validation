        width_in_cm_main=7,
        height_in_cm_main=7,

        width_in_cm_legend_cell_type=7,
        height_in_cm_legend_cell_type=3,

        width_in_cm_legend_arrow=3,
        height_in_cm_legend_arrow=1.5,
    resources:
        slurm_partition="cpu",
        runtime=5,# 5 minutes
        mem_mb=4_000,# 4 GB
