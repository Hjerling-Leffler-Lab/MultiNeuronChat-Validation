# Bianca cannot pull docker:// images: pass the local .sif there with --config container=/proj/.../<name>.sif
container: config.get("container", "docker://ghcr.io/siedler/multi-neuron-chat-validation-pipeline:2026.9.5.dev0")

# Frozen for revision 1: coarse annotation (grouping.by), CVM, BH-adjusted p < 0.05, no prefilter
statistical_tests = ["CVM"]

# BH-adjusted p-value thresholds per test for the plots, independent of the MNC run above;
# each threshold gets its own figure set under results/figs/coarse/{test}/padj_{threshold}/
plot_thresholds = {"CVM": [0.05]}
plot_test_dirs = [f"{test}/padj_{threshold}" for test, thresholds in plot_thresholds.items() for threshold in thresholds]
plot_tests = [test for test, thresholds in plot_thresholds.items() for _ in thresholds]
plot_threshold_values = [threshold for thresholds in plot_thresholds.values() for threshold in thresholds]

mnc_object = "results/coarse/mnc_grouping_by.pkl"
clinical_data = "data/raw/ROSMAP_clinical.csv"
fig_dir = "results/figs/coarse/{test}/padj_{threshold}"

# Tetrad selection for the AD-only donor x tetrad communication-score clustermap (Fig. 3N)
clustermap_selections = ["significant"]

wildcard_constraints:
    threshold=r"[0-9.]+",

rule run_all:
    input:
        mnc_object,
        "results/coarse/timings.pkl",

# Fig. 3A circle plot, 3B-I boxplots, 3J-M ligand/target decomposition, 3N AD-only clustermap, 3O clinical covariate
# heatmap, Supp. Fig. 6A-H sex-stratified boxplots, the zero-bar score histograms, and the Excel summary table
rule plot_all:
    input:
        "results/figs/clinical_data_plot.pdf",

        expand("results/figs/coarse/{test_dir}/{ext}/p_value_circle_plot.{ext}",test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/coarse/{test_dir}/{ext}/p_value_legend.{ext}",test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/coarse/{test_dir}/{ext}/p_value_arrow_legend.{ext}",test_dir=plot_test_dirs,ext=["png", "pdf"]),

        expand("results/figs/coarse/{test_dir}/{ext}/significant_boxplots.{ext}",test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/coarse/{test_dir}/{ext}/ligand_target_decomposition.{ext}",test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/coarse/{test_dir}/{ext}/single_panels/ligand_target_decomposition",test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/coarse/{test_dir}/{ext}/score_clustermap_AD_only_{selection}.{ext}",test_dir=plot_test_dirs,selection=clustermap_selections,ext=["png", "pdf"]),
        expand("results/figs/coarse/{test_dir}/{ext}/clinical_covariates/summary_heatmap.{ext}",test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/coarse/{test_dir}/{ext}/sex_stratified_boxplots.{ext}",test_dir=plot_test_dirs,ext=["png", "pdf"]),
        expand("results/figs/coarse/{test_dir}/{ext}/score_histograms.{ext}",test_dir=plot_test_dirs,ext=["png", "pdf"]),

        expand("results/tables/T5_ROSMAP_summary_{test}_padj_{threshold}.xlsx",zip,test=plot_tests,threshold=plot_threshold_values),


rule join_rosmap_data:
    input:
        path_to_script="src/1_join_rosmap_data.py",

        path_to_cell_annotations="data/raw/cell-annotation.n437.csv",
        path_to_clinical_data=clinical_data,
        path_to_matrices="data/raw/count_matrices",
    output:
        path_to_output_loom="data/raw/joined_matrix.loom",
    resources:
        slurm_partition="cpu",
        runtime=600,# 10 hours
        mem_mb=45_000,# 45 GB
    shell:
        """
        python {input.path_to_script} \
            --path_to_cell_annotations {input.path_to_cell_annotations} \
            --path_to_clinical_data {input.path_to_clinical_data} \
            --path_to_matrices {input.path_to_matrices} \
            --path_to_output_loom {output.path_to_output_loom}
        """

